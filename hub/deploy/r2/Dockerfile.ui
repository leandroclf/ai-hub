FROM node:22.23.2-alpine AS build
ARG VITE_OIDC_ISSUER=http://localhost:18085/realms/ai-hub-r2
ARG VITE_OIDC_CLIENT_ID=ai-hub-admin
ENV VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
WORKDIR /app
COPY admin-ui/package*.json ./
RUN npm ci --ignore-scripts
COPY admin-ui/ ./
RUN npm run build
FROM nginxinc/nginx-unprivileged:1.29.1-alpine@sha256:27985295bdb22a1ef8f712863210bd5877c0f3006494a593e86b3fe0fa55467e
COPY deploy/r2/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
