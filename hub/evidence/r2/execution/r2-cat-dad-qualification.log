[catalog-and-product]
command=R2_CORE_TEST_DSN=<fixture> R2_FINANCE_DSN=<fixture> ATLAS_TEST_DSN=<fixture> go test -count=1 -race -v ./internal/atlas ./internal/orbita -run 'Test(DAGContract|TechnicalProjectionRejectsInvalidJSONDocumentsAndTypes|TechnicalProjectionEnforcesPublishedDialectAndBounds|ImportSecretSanitization|CatalogValidation|CatalogPublicationRejectsBindingFromAnotherProviderAccount|CatalogPostgresPaginationAndStaging|CatalogImportDiffStates|ProductPlanPersistsDependenciesAndConsolidatesAfterAllSteps|ProductPlanCompensationIsASeparateTrackedOperation)$'
